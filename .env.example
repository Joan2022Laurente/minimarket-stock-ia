# ==============================================================================
# MINIMARKET EL BUEN VECINO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCCIONES:
# Copia este archivo como .env y rellena los valores correspondientes.
# NUNCA agregues valores de producción ni credenciales reales en este archivo.
# ==============================================================================

# --- ENTORNO Y APLICACIÓN ---
ENVIRONMENT=development                # development | staging | production
PROJECT_NAME="Minimarket El Buen Vecino"
API_V1_STR="/api/v1"
SECRET_KEY=cambiar_por_clave_segura_de_32_caracteres_minimo
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://buenvecino.duckdns.org"

# --- SUPABASE (POSTGRESQL & AUTH) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_publica
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_privada
DATABASE_URL=postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:5432/postgres

# --- AWS (INFRAESTRUCTURA Y S3 BACKUPS) ---
AWS_REGION=us-east-1                   # us-east-1 o sa-east-1
AWS_S3_BACKUP_BUCKET=buenvecino-backups-bucket
# NOTA: En la instancia EC2, las credenciales se obtienen via IAM Instance Profile.
# Solo en desarrollo local se completan estas claves si se prueba S3 directamente:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- MACHINE LEARNING (LIGHTGBM ENGINE) ---
ML_MODEL_PATH=app/ml/artifacts/model_latest.joblib
ML_RETRAIN_CRON="0 0 * * 0"           # Todos los domingos a las 00:00 UTC
ML_INFERENCE_CRON="0 0 * * *"         # Todas las noches a las 00:00 UTC
ML_LOOKBACK_DAYS=90                   # Días históricos para entrenamiento
ML_FORECAST_HORIZON_DAYS=7            # Días proyectados a futuro

# --- LLM EXPLICABILIDAD (OPCIONAL / OPENROUTER O BEDROCK) ---
LLM_PROVIDER=openrouter               # openrouter | bedrock | none
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_MAX_SPEND_USD=5.00

# --- OBSERVABILIDAD Y ALERTAS ---
PROMETHEUS_METRICS_PORT=8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_password_admin_grafana
ALERT_EMAIL_TO=administrador@elbuenvecino.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password
