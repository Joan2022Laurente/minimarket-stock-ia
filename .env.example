# Laboratorio. Copiar a .env.lab, separado de cualquier .env existente.
ENVIRONMENT=development
SECRET_KEY=
DATABASE_URL=
ALLOWED_ORIGINS='["http://localhost:8080"]'

BACKEND_IMAGE=minimarket-backend:local
FRONTEND_IMAGE=minimarket-frontend:local

# Configuracion futura de Caddy HTTPS. El override de laboratorio usa localhost.
SITE_ADDRESS=
ACME_EMAIL=
ACME_CA=staging

ML_MODEL_PATH=/app/app/ml/artifacts/model_latest.joblib
ML_METADATA_PATH=/app/app/ml/artifacts/model_metadata.json
AWS_REGION=us-east-1
AWS_S3_BACKUP_BUCKET=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# El override local fija la etiqueta laboratorio. La base acepta produccion o sin-etiquetar.
MONITORING_ENVIRONMENT=sin-etiquetar
# Si se define, debe ser un directorio existente y dedicado al entorno.
MONITORING_TEXTFILE_DIR=

# El backup usa un entorno propio del host. Ver docs/devops/INIT-005-automatizacion-continuidad.md.
# BACKUP_PG_SERVICE, PGSERVICEFILE, PGPASSFILE, BACKUP_WORK_DIR y BACKUP_TIMEZONE
# se entregan al proceso Bash. Compose no los transmite al backend.
