    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "entorno",
        "label": "Entorno",
        "datasource": {
          "type": "prometheus",
          "uid": "buenvecino-prometheus"
        },
        "definition": "label_values(up, environment)",
        "query": {
          "query": "label_values(up, environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "type": "query",
        "name": "instancia",
        "label": "Instancia",
        "datasource": {
          "type": "prometheus",
          "uid": "buenvecino-prometheus"
        },
        "definition": "label_values(up{job=\"node-exporter\",environment=~\"${entorno:regex}\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"node-exporter\",environment=~\"${entorno:regex}\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "type": "query",
        "name": "interfaz",
        "label": "Interfaz",
        "datasource": {
          "type": "prometheus",
          "uid": "buenvecino-prometheus"
        },
        "definition": "label_values(node_network_receive_bytes_total{job=\"node-exporter\",environment=~\"${entorno:regex}\",instance=~\"${instancia:regex}\",device=~\"(eth|en|bond)[a-zA-Z0-9_.-]*\"}, device)",
        "query": {
          "query": "label_values(node_network_receive_bytes_total{job=\"node-exporter\",environment=~\"${entorno:regex}\",instance=~\"${instancia:regex}\",device=~\"(eth|en|bond)[a-zA-Z0-9_.-]*\"}, device)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
