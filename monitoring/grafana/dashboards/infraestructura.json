{
  "uid": "buenvecino-infraestructura",
  "title": "Buen Vecino | Infraestructura",
  "description": "En Docker Desktop corresponde a la VM Linux y a los namespaces de sus collectors. En EC2 validar dispositivos, montajes e interfaces.",
  "tags": [
    "buen-vecino",
    "observabilidad"
  ],
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
