{
  "uid": "buenvecino-contenedores",
  "title": "Buen Vecino | Contenedores Docker",
  "description": "Series Compose con muestra reciente de cAdvisor. Presencia, scrape y salud funcional son señales independientes.",
  "tags": [
    "buen-vecino",
    "observabilidad"
  ],
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "entorno",
        "label": "Entorno",
        "datasource": {
          "type": "prometheus",
          "uid": "buenvecino-prometheus"
        },
        "definition": "label_values(up, environment)",
        "query": {
          "query": "label_values(up, environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "type": "query",
        "name": "proyecto",
        "label": "Proyecto Compose",
        "datasource": {
          "type": "prometheus",
          "uid": "buenvecino-prometheus"
        },
        "definition": "label_values(container_last_seen{job=\"cadvisor\",environment=~\"${entorno:regex}\",container_label_com_docker_compose_project!=\"\",container_label_com_docker_compose_service!=\"\"}, container_label_com_docker_compose_project)",
        "query": {
          "query": "label_values(container_last_seen{job=\"cadvisor\",environment=~\"${entorno:regex}\",container_label_com_docker_compose_project!=\"\",container_label_com_docker_compose_service!=\"\"}, container_label_com_docker_compose_project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "type": "query",
        "name": "servicio",
        "label": "Servicio",
        "datasource": {
          "type": "prometheus",
          "uid": "buenvecino-prometheus"
        },
        "definition": "label_values(container_last_seen{job=\"cadvisor\",environment=~\"${entorno:regex}\",container_label_com_docker_compose_project=~\"${proyecto:regex}\",container_label_com_docker_compose_service!=\"\"}, container_label_com_docker_compose_service)",
        "query": {
          "query": "label_values(container_last_seen{job=\"cadvisor\",environment=~\"${entorno:regex}\",container_label_com_docker_compose_project=~\"${proyecto:regex}\",container_label_com_docker_compose_service!=\"\"}, container_label_com_docker_compose_service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
