      "datasource": {
        "type": "prometheus",
        "uid": "buenvecino-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "buenvecino-prometheus"
          },
          "editorMode": "code",
          "expr": "min(up{job=\"cadvisor\",environment=~\"${entorno:regex}\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Sin datos",
          "mappings": [
