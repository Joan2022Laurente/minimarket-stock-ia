{
  "uid": "buenvecino-aplicacion",
  "title": "Buen Vecino | Aplicación y Predicciones",
  "description": "Operaciones de laboratorio con fixtures. WAPE carece de procedencia validada para negocio. /ready y respaldo verificado siguen pendientes.",
  "tags": [
    "buen-vecino",
    "observabilidad"
  ],
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "entorno",
        "label": "Entorno",
        "datasource": {
          "type": "prometheus",
          "uid": "buenvecino-prometheus"
        },
        "definition": "label_values(up, environment)",
        "query": {
          "query": "label_values(up, environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Disponibilidad y tráfico",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape de FastAPI",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "description": "Disponibilidad de las métricas privadas. No mide Supabase.",
      "datasource": {
        "type": "prometheus",
        "uid": "buenvecino-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "buenvecino-prometheus"
          },
          "editorMode": "code",
          "expr": "min(up{job=\"fastapi-backend\",environment=~\"${entorno:regex}\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Sin datos",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Caído",
                  "color": "red"
                },
                "1": {
                  "text": "Disponible",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
