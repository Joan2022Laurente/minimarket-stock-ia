          "editorMode": "code",
          "expr": "minimarket_probe_success{job=\"node-exporter\",check=\"spa\",environment=~\"${entorno:regex}\"} and on(instance,check) (time() - minimarket_probe_timestamp_seconds{job=\"node-exporter\",check=\"spa\",environment=~\"${entorno:regex}\"} <= 45)",
